# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# GOOGLE_API_KEY is also accepted as a fallback.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Gemini model matrix (Fusionista Lab / Intelligence Core) ---
# Free-tier keys often return 429 with limit:0 for Pro models (e.g. gemini-3.1-pro).
# Default: prefer free-tier flash first, then fall back on quota errors.
GEMINI_PREFER_FREE_TIER=1
GEMINI_ENABLE_THINKING=1
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_LITE=gemini-2.0-flash-lite
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
# Optional ordered chain (comma-separated). Overrides default reasoning chain order.
# GEMINI_MODEL_REASONING_CHAIN=gemini-2.5-flash,gemini-2.0-flash,gemini-2.0-flash-lite
# GEMINI_MODEL_IMAGE=gemini-3.1-flash-image
# GEMINI_MODEL_TTS=gemini-3.1-flash-tts-preview
